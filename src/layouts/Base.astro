---
import { PREFS_INLINE_SCRIPT } from '../site/prefs-script';
import Preferences from '../components/Preferences.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Blog của lamter, hiển thị như một trình duyệt blockchain.' } = Astro.props;

/**
 * The nav names the site's full shape, not just what this build produces —
 * `/tx`, `/address`, `/assets`, `/mempool` and `/verify` belong to later
 * plans and have no route yet. `built: false` is the only difference between
 * an entry here and a real link: the label, order and position stay put, and
 * the next plan lands a route by flipping one boolean rather than editing
 * markup. Rendering it as a link anyway would send a reader to the 404 page.
 */
interface NavEntry {
  href: string;
  label: string;
  built: boolean;
}

const NAV: NavEntry[] = [
  { href: '/blocks', label: 'Blocks', built: true },
  { href: '/tx', label: 'Transactions', built: false },
  { href: '/address', label: 'Addresses', built: false },
  { href: '/assets', label: 'Assets', built: false },
  { href: '/mempool', label: 'Mempool', built: false },
  { href: '/verify', label: 'Verify', built: false },
];
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline set:html={PREFS_INLINE_SCRIPT} />
  </head>
  <body>
    <nav class="nav">
      <a class="brand" href="/">lamter<span>.eth</span></a>
      <ul>
        {NAV.map((entry) => (
          <li>{entry.built ? (
            <a href={entry.href}>{entry.label}</a>
          ) : (
            <span class="soon">{entry.label}</span>
          )}</li>
        ))}
      </ul>
      <Preferences />
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
