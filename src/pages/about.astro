---
import Base from '../layouts/Base.astro';
import TxRow from '../components/TxRow.astro';
import { CHAIN_CONFIG } from '../../chain.config';
import { identityAddress } from '../chain/address';
import { senders } from '../site/addresses';
import { researchHours } from '../site/chain-data';
import { renderMarkdown } from '../site/markdown';
import { getProfile } from '../site/profile';
// `.card`, `.meta`, `.hash`, `.addr`, `.num`, `.txs`, `.bio` and
// `.profile-links` are all in chain.css — reused verbatim (see the note on
// `src/pages/address/[name].astro`) so this reads as the same chrome as
// every other address page rather than a one-off. `.page-head` comes from
// base.css, which `Base.astro` already loads on every route.
import '../styles/chain.css';

/**
 * §3.7/§6 — the author's own address: `sha256("addr/1|identity|" + handle)`,
 * and the same page as `/about` per §6 ("bio, verified social links, ...,
 * transaction history"). This route builds that page; `/address/lamter.eth`
 * itself is out of this task's file list and is not built here — nothing on
 * the site links to it (`TxPanel` never links a transaction's `from`), so no
 * dead link results from leaving it unbuilt.
 *
 * The address always comes from `identityAddress`, never from anything
 * `content/profile.md` might also carry — a second, un-hash-checked copy of
 * the handle is exactly the kind of drift §3.7 exists to prevent. `getProfile`
 * supplies only the bio and links.
 *
 * §5.1/D18 — the profile is off-chain by the author's own choice, and this
 * page must say so: it is framed as an identity *address* page and surrounds
 * the bio with a real address and real totals, so unlabelled prose would
 * read as though it carried the same guarantee. The bio and links render
 * inside their own dashed "Ngoài chuỗi" card, above and visibly distinct
 * from the committed one — see `hasProfileContent` below.
 *
 * No clock is read here or under `src/site/` (§14): `senders()` reads the
 * ledger plus the recorded open block, and `getProfile()` reads a file on
 * disk, so the same inputs build the same page on any day.
 */
const address = await identityAddress(CHAIN_CONFIG.authorHandle);
const profile = getProfile();
const bioHtml = profile.bio.trim() === '' ? '' : await renderMarkdown(profile.bio);
// §6: "renders a link only for a profile entry that declares a url".
//
// An entry that declares none is still *named* — as plain text, exactly the way
// `src/site/routes.ts` renders a route the build has not produced and the way
// `TxPanel` renders a tag when `/address` is unbuilt. That rule already governs
// every internal link on this site: the site never links to what does not
// exist. An external url that does not exist is the same claim, and this page
// shipped three of them (`https://github.com/your-handle` and two more) as live
// anchors under a heading §6 calls "verified social links". Dropping the entry
// entirely was the old behaviour and hides from the author that the row is
// there; a plain-text label says "this profile has a GitHub, its url is not
// filled in yet" without asserting where it points.
const links = profile.links;

// Every post is sent FROM the author's address (§3.7), so its whole
// transaction history is the whole chain — `senders()` is exactly that list,
// shared with the tag/series address pages so the ordering cannot drift
// between them. Every entry is a `ResolvedPost` (§3.9): the state the chain
// asserts now, not the sealed original.
const transactions = senders();
const dates = transactions.map((t) => t.date).sort();
const firstSeen = dates[0] ?? '';
const lastSeen = dates[dates.length - 1] ?? '';

// §3.8/§3.9 — the total declared research hours across every post's *current*
// state, summed over the very objects the rows below render. The header and
// the rows are one number and its parts; they cannot disagree the way they did
// when the total resolved amendments and the rows did not.
const totalHours = researchHours(transactions.reduce((sum, p) => sum + p.value, 0));

// §5.1/D18 — `content/profile.md` is off-chain by the author's own choice: a
// bio is identity metadata, not a claim about the chain's contents, and
// nothing hashes it. But this page is framed as an identity *address* page
// and surrounds the bio with a real address and real totals, so unlabelled
// prose would inherit an authority nothing gave it. Nothing to mark when
// there is nothing to show — an author who has written neither a bio nor a
// link gets no empty "off-chain" card either.
const hasProfileContent = bioHtml !== '' || links.length > 0;
---

<Base
  title={`${CHAIN_CONFIG.authorName} — Blogchain`}
  description={`Địa chỉ định danh của ${CHAIN_CONFIG.authorName} · ${transactions.length} giao dịch trên toàn chuỗi.`}
>
  <div class="page-head">
    <h1>{CHAIN_CONFIG.authorName}</h1>
    <span class="sub">Identity address</span>
  </div>

  {hasProfileContent ? (
    // §5.1 — the author-supplied half, visibly distinct from the committed
    // card below it: the same dashed `.card.offchain` treatment and `.stamp
    // off` badge the mempool uses for a draft (src/pages/mempool.astro),
    // reusing that vocabulary rather than inventing a second one. The note's
    // own wording says the same thing the mempool's does: `chưa lên chuỗi`.
    <article class="card offchain" aria-label="Thông tin do tác giả khai báo">
      <div class="card-top">
        <span class="per">Giới thiệu</span>
        <span class="stamp off">Ngoài chuỗi</span>
      </div>
      <p class="off-note">
        Tiểu sử và liên kết bên dưới do tác giả tự khai báo, <strong>chưa lên chuỗi</strong>:
        không có hash, không được chuỗi xác minh. Địa chỉ, số giao dịch, giờ nghiên cứu và
        lịch sử giao dịch trong thẻ bên dưới mới là dữ liệu chuỗi đã xác nhận.
      </p>
      {bioHtml ? <div class="bio" set:html={bioHtml} /> : null}
      {links.length > 0 ? (
        <ul class="profile-links">
          {links.map((link) => (
            <li>{link.url === '' ? (
              <span class="unlinked">{link.label}</span>
            ) : (
              <a href={link.url}>{link.label}</a>
            )}</li>
          ))}
        </ul>
      ) : null}
    </article>
  ) : null}

  <article class="card" data-address={CHAIN_CONFIG.authorName} aria-label={`Address ${CHAIN_CONFIG.authorName}`}>
    <div class="card-top">
      <span class="per">Address</span>
    </div>
    <dl class="meta">
      <dt>Address</dt>
      <dd><span class="addr">{address}</span></dd>
      <dt>Handle</dt><dd>{CHAIN_CONFIG.authorHandle}</dd>
      <dt>Type</dt><dd>Identity</dd>
      <dt>Txns</dt><dd><span class="num">{transactions.length}</span></dd>
      <dt>Research</dt>
      <dd>{totalHours ? <Fragment><span class="num">{totalHours}</span> giờ nghiên cứu</Fragment> : '—'}</dd>
      <dt>First seen</dt><dd>{firstSeen}</dd>
      <dt>Last seen</dt><dd>{lastSeen}</dd>
    </dl>
    <ul class="txs">
      {transactions.map((post) => <TxRow post={post} />)}
    </ul>
  </article>
</Base>
