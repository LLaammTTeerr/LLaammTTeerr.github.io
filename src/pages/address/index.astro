---
import Base from '../../layouts/Base.astro';
import { getAddresses } from '../../site/addresses';
import { researchHours, shortHash } from '../../site/chain-data';
// Same card and list chrome as /blocks — see the note in [name].astro.
import '../../styles/chain.css';

/**
 * §3.7 — every tag and series address on the chain.
 *
 * This page exists because `src/site/routes.ts` carries one `built` flag per
 * route, and the nav renders `/address` from it. Flipping that flag so
 * `TxPanel` can link `/address/<tag>.tag` also turns the nav's "Addresses"
 * entry into a real link, so `/address` has to be a real page — the site
 * ships no dead links, and a nav entry pointing at a bare directory is one.
 *
 * A list, so every address is middle-truncated (§3.1): the full 40 hex digits
 * belong on the address's own page, where a reader verifies them.
 */
const rows = (await getAddresses()).map((address) => ({
  address,
  short: shortHash(address.address),
  // §3.8 — null when this address received no declared hours at all, which
  // displays as an em dash and never as a bare `0.0 giờ`.
  hours: researchHours(address.valueReceived),
}));
---

<Base title="Addresses — Blogchain" description="Mọi tag và series trên chuỗi, dưới dạng địa chỉ.">
  <div class="page-head">
    <h1>Addresses</h1>
    <span class="sub"><span class="num">{rows.length}</span> địa chỉ</span>
  </div>

  <article class="card" aria-label="Addresses">
    <div class="card-top">
      <span class="per">Tags và series</span>
    </div>
    {rows.length > 0 ? (
      <ul class="txs">
        {rows.map(({ address, short, hours }) => (
          <li>
            <h2 class="t"><a href={`/address/${address.name}`}>{address.name}</a></h2>
            <span class="g">
              <span class="addr">{short}</span>
              {' · '}<span class="num">{address.txCount}</span> giao dịch{' · '}
              {hours ? <Fragment><span class="num">{hours}</span> giờ</Fragment> : '—'}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="silent">Chưa có bài viết nào gửi tới địa chỉ nào.</p>
    )}
  </article>
</Base>
