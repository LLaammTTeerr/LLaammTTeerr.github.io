---
import Base from '../layouts/Base.astro';
import StatsBar from '../components/StatsBar.astro';
import BlockCard from '../components/BlockCard.astro';
import { getBlocks } from '../site/chain-data';
// No chain.css import here: StatsBar, BlockCard and WorkMeter each import
// the styles they need, so a new route that renders them cannot ship
// unstyled by forgetting a page-level import.

const blocks = getBlocks();
---

<Base title="Blogchain — lamter.eth">
  <h1 class="sr-only">Blogchain — lamter.eth</h1>
  <StatsBar />
  <div class="chain">
    {blocks.map((block, i) => (
      <BlockCard block={block} isNewest={i === 0} isOldest={i === blocks.length - 1} />
    ))}
  </div>
</Base>
