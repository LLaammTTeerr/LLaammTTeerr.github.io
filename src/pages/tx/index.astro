---
import Base from '../../layouts/Base.astro';
import LedgerRow from '../../components/LedgerRow.astro';
import { transactionIndex } from '../../site/tx-index';
// `.card`, `.card-top`, `.per`, `.stamp`, `.txs`, `.tx-list` and `.silent` are
// BlockCard's classes (src/styles/chain.css), reused verbatim so the
// transaction index reads as the same chrome as the block list rather than
// drifting into a second style. `.page-head` lives in base.css, which
// `Base.astro` always loads.
import '../../styles/chain.css';

/**
 * §6 — every transaction on the chain, newest first: the counterpart of
 * `/blocks`, and the same *kind* of surface as it.
 *
 * `/blocks` answers "what did each block seal". This answers "what is on the
 * chain". Both are ledger views, so both render a `RecordedTx` through the one
 * shared meta line (see `LedgerRow.astro`): a row here is one transaction,
 * printing its own hash, its own committed title and its own gas and hours —
 * never a resolved one. A post and an amendment each get
 * exactly one row, so every transaction hash on the chain appears on this page
 * exactly once — which is the whole of what an index owes a reader.
 *
 * It deliberately does **not** resolve (§3.9). Resolving made an amended post's
 * row print the amendment's hash, so that hash sat on two rows while the post
 * transaction's own hash sat on none, and `/tx` and `/blocks` named the same
 * transaction differently. "What is this post now" belongs to `/tx/<slug>`,
 * which resolves, states `Amends`, and says which block the amendment is in —
 * one click from every row here.
 *
 * The list is split in two, and the split is §3.6's: what the chain has sealed
 * and what it has not. The open block's transactions are real, hashed and in
 * the chain but not yet immutable, and running them together with the sealed
 * history would leave the `~` on each hash carrying that alone. Each group is
 * stamped the way `/blocks` stamps the block it describes, and now that every
 * row states its own transaction, both stamps are true of every row under them.
 *
 * **No truncation and no paging**, deliberately. `/about` already lists every
 * post on the chain on one page, so a flat index is not a new scale problem;
 * what this adds is the amendments, a fraction of the posts. A paged
 * `/tx/page/2` would have to live in the same namespace as `/tx/<slug>`, where
 * a post slugged `page` would shadow it. When the list does get long the answer
 * is the homepage's: truncate *there* and link here, which is what `/blocks`
 * already does.
 *
 * No clock is read here or under `src/site/` (§14).
 */
const index = transactionIndex();
---

<Base title="Transactions — Blogchain" description="Mọi giao dịch trên chuỗi, mới nhất trước.">
  <div class="page-head">
    <h1>Transactions</h1>
    <span class="sub"><span class="num">{index.total}</span> giao dịch · mới nhất trước</span>
  </div>

  {index.open.length > 0 ? (
    <article class="card" aria-label="Pending transactions">
      <div class="card-top">
        <span class="per">Khối đang mở{index.openPeriod === null ? '' : ` · ${index.openPeriod}`}</span>
        <span class="stamp open">Chưa niêm phong</span>
      </div>
      <ul class="txs tx-list" data-tx-list="open">
        {index.open.map((row) => <LedgerRow row={row} />)}
      </ul>
    </article>
  ) : null}

  <article class="card" aria-label="Sealed transactions">
    <div class="card-top">
      <span class="per">Khối đã niêm phong</span>
      <span class="stamp">Sealed</span>
    </div>
    {index.sealed.length > 0 ? (
      <ul class="txs tx-list" data-tx-list="sealed">
        {index.sealed.map((row) => <LedgerRow row={row} />)}
      </ul>
    ) : (
      <p class="silent">Chưa có giao dịch nào trong khối đã niêm phong.</p>
    )}
  </article>
</Base>
