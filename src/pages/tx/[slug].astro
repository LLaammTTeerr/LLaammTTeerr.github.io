---
import Base from '../../layouts/Base.astro';
import TxPanel from '../../components/TxPanel.astro';
import TxVerifier from '../../components/TxVerifier.astro';
import { getPendingPosts, getPostContent, getPosts } from '../../site/chain-data';
import { renderMarkdown } from '../../site/markdown';
import '../../styles/post.css';
import '../../styles/katex.css';

/**
 * Every post in the chain gets a page — sealed or not (§3.6). A post
 * published into the still-open month has a real hash and a real transaction
 * the moment `chain:build` records it; withholding its page until month-end
 * would make a freshly published post indistinguishable from a publishing
 * failure.
 *
 * The paths carry the slug and nothing else. Everything this page states comes
 * from `getPostContent`, which is the one place that resolves *which* recorded
 * transaction the body on disk matches — the sealed original, or the newest
 * amendment superseding it (§3.9). Passing the sealed transaction through as a
 * prop is what shipped an amended body under the original's hash, title, tags,
 * gas and value, stamped `Sealed`: two answers to "which transaction is this
 * page about", from two places, silently disagreeing.
 *
 * No clock is read here, and none is passed: `getPendingBlock()` returns the
 * placement `chain:build` recorded (§14), so this route renders the same pages
 * on any day for the same chain.
 */
export function getStaticPaths() {
  return [...getPosts(), ...getPendingPosts()].map((tx) => ({
    params: { slug: tx.slug! },
    props: { slug: tx.slug! },
  }));
}

const { slug } = Astro.props;
// Throws if the file on disk no longer matches the chain — the build fails
// rather than shipping a page whose verify control would contradict it.
const content = await getPostContent(slug);
const html = await renderMarkdown(content.body);

// The chain's current word on this post — title, hash, gas, hours, tags —
// resolved once in `chain-data.ts` and handed to the panel whole. This is the
// same object `/address/<tag>` and `/about` render their rows from, so the
// three surfaces cannot state different things about one post.
const post = content.post;
---

<Base title={`${post.title} — Blogchain`} description={`${post.title} · ${content.gasUsed} từ`}>
  {/*
    §6.1 (revised 2026-08-04) — two columns above 62rem, one below.

    The article comes first in the document and the panel second, which is the
    reverse of what this page used to render. Document order is what a screen
    reader follows at every width, and the title and the prose are what a reader
    came for; a 64-character hash read out ahead of them is chrome in front of
    content. The rail is placed to the right by the grid and hoisted above the
    article by `order` when the grid collapses (src/styles/post.css) — the
    layout moves, the reading order does not.
  */}
  <div class="post-layout">
    <div class="post-col">
      <article class="post card">
        {/*
          §6.1's reading-progress indicator. Decorative, and nothing but a
          painted bar: `aria-hidden`, no text, no role. It is inside the article
          because the article is what it measures — the CSS names this element's
          own ancestor as the animation's timeline, so there is no way for it to
          drift onto the document's extent. `data-on` starts `false` and
          src/site/reading-progress.ts flips it only when the article is taller
          than the viewport.
        */}
        <div class="post-progress" data-on="false" aria-hidden="true"><i></i></div>
        <h1>{post.title}</h1>
        <p class="byline">{post.date} · {post.tags.map((t) => `#${t}`).join(' ')}</p>
        <Fragment set:html={html} />
      </article>
      {/*
        §7 — after the text, not before it. The reader came to read; the offer to
        check what they just read only means anything once they have. The control
        verifies `post` — the resolution — because that is the record the panel and
        the body above it describe (§3.9).

        In the reading column rather than the rail or a band under both, and the
        §7 argument is why: "after the text" is a statement about the sequence a
        reader moves through, which only means anything if the two are in one
        column. It is also far too big for a 20rem rail — a step list, prose and
        a `curl` command — and a full-width band under two columns would be the
        very misalignment §6.1 removed. Beside it, the rail is still stuck to the
        top of the screen, so the hash being checked is on screen while it runs.
      */}
      <TxVerifier post={post} />
    </div>
    <aside class="post-rail">
      <TxPanel post={post} />
    </aside>
  </div>
</Base>

<script>
  import { watchReadingProgress } from '../../site/reading-progress';

  // The only JavaScript §6.1 needs: the bar itself is a CSS scroll-driven
  // animation, and this decides whether there is any progress to show at all.
  watchReadingProgress(document, window);
</script>
