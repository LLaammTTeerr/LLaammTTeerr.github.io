---
import type { Transaction } from '../chain/types';
import type { AmendedIn } from '../site/chain-data';
import { getBlocks, getPendingBlock, researchHours } from '../site/chain-data';
import { routeById } from '../site/routes';
import PendingState from './PendingState.astro';
// `.meta`, `.hash` and `.num` are BlockCard's dense-metadata classes
// (src/styles/chain.css) — reused verbatim here rather than redefined, so
// the transaction panel and the block cards read as the same monospace,
// token-coloured chrome instead of drifting into two competing styles.
import '../styles/chain.css';
import '../styles/post.css';

// Every prop is required on purpose, with no default.
//
// `pending`: a caller that forgot it used to render `Sealed` over an
// unconfirmed transaction — the one falsehood §3.6 is most explicit about ("a
// pending hash presented with the same authority as a sealed one would be the
// single most misleading thing this site could display").
//
// `gasUsed` and `value`: a transaction cannot state either about itself once
// it is an amendment. §3.9 fixes an amendment's `gasUsed` and `value` at 0 so
// block aggregation cannot re-charge the original's, and puts the declared
// hours in `research` instead. Defaulting to `tx.gasUsed` / `tx.value` would
// therefore print `0 từ · —` under an amended post's text, so the caller — the
// only party that knows which body is on screen — has to supply both.
interface Props {
  /** The transaction being described: the one whose hash commits to the text. */
  tx: Transaction;
  pending: boolean;
  /** §3.8 — word count of the body shown beside this panel. */
  gasUsed: number;
  /** §3.8 — declared research hours from the record `tx` is. */
  value: number;
  /** §3.9 — set when `tx` is the amendment that supersedes an earlier record. */
  amendedIn: AmendedIn | null;
}
const { tx, pending, gasUsed, value, amendedIn } = Astro.props;

// A pending transaction is in no sealed block, and `getBlocks()` reads sealed
// history only — searching it for one found nothing and rendered `—` for the
// block it is plainly in. The open block is where it is, so that is where it
// is looked up. Both views carry `height` and `period`, which is all this row
// reads; nothing here touches a field only a sealed block has.
const block = pending
  ? getPendingBlock()
  : getBlocks().find((b) => b.transactions.some((t) => t.hash === tx.hash));
const readMinutes = Math.max(1, Math.round(gasUsed / 200));
// null when the author declared no `research` — §3.8 wants an em dash there,
// not the `0.0` the chain (correctly) committed.
const hours = researchHours(value);

// A tag or series is an address in the `/address` namespace, which — like
// the nav entries in src/site/routes.ts, and read from that same list — has
// no page yet. Naming it stays; linking it to a route this build cannot
// produce would be the identical dead link the nav used to ship.
const address = routeById('address');
---

<div class="txpanel">
  <div class="txpanel-head">
    <span class="lbl">Transaction</span>
    <span class={`stamp${pending ? ' open' : ''}`}>{pending ? 'Chưa niêm phong' : 'Sealed'}</span>
  </div>
  <dl class="meta">
    <dt>Hash</dt>
    <dd>{pending ? (
      <span class="a-hash"><span class="tilde">~</span>{tx.hash}</span>
    ) : (
      <span class="hash">{tx.hash}</span>
    )}</dd>
    <dt>Block</dt>
    <dd>{block ? (
      // A sealed block has a page of its own; the open block does not. Its
      // height is a prediction — a size split can seal a block ahead of it and
      // move it — so `/block/<height>` names a height the chain has not
      // committed to. The open block lives on `/blocks`, and that is where a
      // pending transaction points: an honest link rather than a dead one.
      <a href={pending ? '/blocks' : `/block/${block.height}`}>#{block.height}</a>
    ) : '—'} · {block?.period}{pending ? ' · đang mở' : ''}</dd>
    <dt>Timestamp</dt><dd>{tx.date}</dd>
    <dt>From</dt><dd><span class="addr">{tx.from}</span></dd>
    <dt>To</dt>
    <dd>
      {tx.tags.map((t) => (address.built ? (
        <a class="tagname" href={`${address.href}/${t}.tag`}>{t}.tag</a>
      ) : (
        <span class="tagname">{t}.tag</span>
      )))}
      {tx.series ? (address.built ? (
        <a class="tagname" href={`${address.href}/${tx.series}.series`}>{tx.series}.series</a>
      ) : (
        <span class="tagname">{tx.series}.series</span>
      )) : null}
    </dd>
    <dt>Gas used</dt><dd><span class="num">{gasUsed}</span> từ · {readMinutes} phút đọc</dd>
    <dt>Value</dt>
    <dd>{hours ? <><span class="num">{hours}</span> giờ nghiên cứu</> : '—'}</dd>
    {tx.assets.length > 0 ? (
      <>
        <dt>Assets</dt>
        <dd><span class="num">{tx.assets.length}</span> token</dd>
      </>
    ) : null}
    {amendedIn !== null && tx.amends !== null ? (
      <>
        {/* The transaction this one supersedes. Without it the original hash
            — which is what /blocks and the sealed block's own page still show
            for this post — vanishes from the post page entirely, and a reader
            arriving from either has no way to reconcile the two. */}
        <dt>Amends</dt>
        <dd><span class="hash">{tx.amends}</span></dd>
      </>
    ) : null}
  </dl>
  {amendedIn !== null ? (
    // §3.9 — "The original post page then displays 'Amended in block #N',
    // linking to the amendment." Author-facing copy, so Vietnamese; the field
    // labels above are explorer chrome and stay English.
    //
    // A block number is named only once the amendment has sealed. While it is
    // in the open block its height is a prediction a size split can still
    // change, so naming it would be the same falsehood as `/block/<height>`
    // for the open block, which the branch already refuses to build.
    <p class="amended">{amendedIn.sealed ? (
      <Fragment>Đã sửa trong khối <a href={`/block/${amendedIn.height}`}>#{amendedIn.height}</a></Fragment>
    ) : (
      <Fragment>Đã sửa; bản đính chính đang chờ trong <a href="/blocks">khối chưa niêm phong</a></Fragment>
    )}</p>
  ) : null}
  {pending ? (
    <PendingState
      fill="sửa bài lúc này sẽ đổi hash, chưa sinh bản đính chính"
      segments={null}
    />
  ) : null}
</div>
