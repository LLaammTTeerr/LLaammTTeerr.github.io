---
import type { ResolvedPost } from '../site/chain-data';
import { getAddresses } from '../site/addresses';
import { getBlocks, getPendingBlock, researchHours } from '../site/chain-data';
import { routeById } from '../site/routes';
import PendingState from './PendingState.astro';
// `.meta`, `.hash` and `.num` are BlockCard's dense-metadata classes
// (src/styles/chain.css) — reused verbatim here rather than redefined, so
// the transaction panel and the block cards read as the same monospace,
// token-coloured chrome instead of drifting into two competing styles.
import '../styles/chain.css';
import '../styles/post.css';

// One prop, and it is the resolution.
//
// This panel used to take five: the transaction plus `pending`, `gasUsed`,
// `value` and `amendedIn`, each of which the caller had to compute correctly
// and consistently with the other four. A caller that forgot `pending`
// rendered `Sealed` over an unconfirmed transaction — the one falsehood §3.6
// is most explicit about — and a caller that let `gasUsed`/`value` default to
// the transaction's own fields printed `0 từ · —` under an amended post,
// because §3.9 fixes an amendment's at 0 so block aggregation cannot re-charge
// the original's.
//
// `ResolvedPost` carries all five as one object that cannot be assembled
// wrongly: `src/site/chain-data.ts` is the only thing that builds one, from a
// single walk. A raw `Transaction` or `RecordedTx` is a type error here.
interface Props {
  post: ResolvedPost;
}
const { post } = Astro.props;
const { pending, value, amendedIn } = post;
// §3.8 — the word count of the body the chain currently vouches for, or an em
// dash. Never a recorded number, on the same rule as the open block's unmined
// hash: a figure that could not be re-derived is not a figure this site prints.
const gasUsed = post.gasUsed;

// A pending transaction is in no sealed block, and `getBlocks()` reads sealed
// history only — searching it for one found nothing and rendered `—` for the
// block it is plainly in. The open block is where it is, so that is where it
// is looked up. Both views carry `height` and `period`, which is all this row
// reads; nothing here touches a field only a sealed block has.
const block = pending
  ? getPendingBlock()
  : getBlocks().find((b) => b.transactions.some((t) => t.hash === post.hash));
const readMinutes = gasUsed === null ? null : Math.max(1, Math.round(gasUsed / 200));
// null when the author declared no `research` — §3.8 wants an em dash there,
// not the `0.0` the chain (correctly) committed.
const hours = researchHours(value);

// A tag or series is an address in the `/address` namespace (§3.7), read from
// the same route list the nav renders from (src/site/routes.ts). That route is
// built now, so these are links again — `/address/<slug>.tag` and
// `/address/<slug>.series`, the pages `src/pages/address/[name].astro`
// produces from the very same tags. The `built` branch stays: naming a tag is
// unconditional, linking it is not, and a route removed later must degrade to
// plain text rather than to the dead link the nav used to ship.
const address = routeById('address');

// …and only when the address itself has a page. §3.9 keeps the tag address
// graph at *original* publication, so a tag an amendment added is displayed
// here (it is the chain's newest declared state, and hash-covered in the
// `amendment/1` form) while no post ever sent to it and `getStaticPaths`
// produces no page for it. Linking it anyway shipped a real dead link: adding
// `moi-them` to a published post rendered `<a href="/address/moi-them.tag">`
// into a build that contains no such page.
//
// Same rule, same shape as `routes.ts`'s `built` flag one line above: name it
// either way, link it only when the target exists.
const built = new Set((await getAddresses()).map((a) => a.name));
const linkable = (name: string): boolean => address.built && built.has(name);
---

<div class="txpanel">
  <div class="txpanel-head">
    <span class="lbl">Transaction</span>
    <span class={`stamp${pending ? ' open' : ''}`}>{pending ? 'Chưa niêm phong' : 'Sealed'}</span>
  </div>
  <dl class="meta">
    <dt>Hash</dt>
    <dd>{pending ? (
      <span class="a-hash"><span class="tilde">~</span>{post.hash}</span>
    ) : (
      <span class="hash">{post.hash}</span>
    )}</dd>
    <dt>Block</dt>
    <dd>{block ? (
      // A sealed block has a page of its own; the open block does not. Its
      // height is a prediction — a size split can seal a block ahead of it and
      // move it — so `/block/<height>` names a height the chain has not
      // committed to. The open block lives on `/blocks`, and that is where a
      // pending transaction points: an honest link rather than a dead one.
      <a href={pending ? '/blocks' : `/block/${block.height}`}>#{block.height}</a>
    ) : '—'} · {block?.period}{pending ? ' · đang mở' : ''}</dd>
    <dt>Timestamp</dt><dd>{post.date}</dd>
    <dt>From</dt><dd><span class="addr">{post.from}</span></dd>
    <dt>To</dt>
    <dd>
      {/* The chain's newest declared tags (§3.9) — an amendment's when one
          supersedes the post — each linked only if that address has a page. */}
      {post.tags.map((t) => (linkable(`${t}.tag`) ? (
        <a class="tagname" href={`${address.href}/${t}.tag`}>{t}.tag</a>
      ) : (
        <span class="tagname">{t}.tag</span>
      )))}
      {post.series ? (linkable(`${post.series}.series`) ? (
        <a class="tagname" href={`${address.href}/${post.series}.series`}>{post.series}.series</a>
      ) : (
        <span class="tagname">{post.series}.series</span>
      )) : null}
    </dd>
    <dt>Gas used</dt>
    <dd>{gasUsed === null ? '—' : (
      <Fragment><span class="num">{gasUsed}</span> từ · {readMinutes} phút đọc</Fragment>
    )}</dd>
    <dt>Value</dt>
    <dd>{hours ? <><span class="num">{hours}</span> giờ nghiên cứu</> : '—'}</dd>
    {post.assets.length > 0 ? (
      <>
        <dt>Assets</dt>
        <dd><span class="num">{post.assets.length}</span> token</dd>
      </>
    ) : null}
    {amendedIn !== null ? (
      <>
        {/* The transaction this one supersedes. Without it the original hash
            — which is what /blocks and the sealed block's own page still show
            for this post — vanishes from the post page entirely, and a reader
            arriving from either has no way to reconcile the two. */}
        <dt>Amends</dt>
        <dd><span class="hash">{post.originalHash}</span></dd>
      </>
    ) : null}
  </dl>
  {amendedIn !== null ? (
    // §3.9 — "The original post page then displays 'Amended in block #N',
    // linking to the amendment." Author-facing copy, so Vietnamese; the field
    // labels above are explorer chrome and stay English.
    //
    // A block number is named only once the amendment has sealed. While it is
    // in the open block its height is a prediction a size split can still
    // change, so naming it would be the same falsehood as `/block/<height>`
    // for the open block, which the branch already refuses to build.
    <p class="amended">{amendedIn.sealed ? (
      <Fragment>Đã sửa trong khối <a href={`/block/${amendedIn.height}`}>#{amendedIn.height}</a></Fragment>
    ) : (
      <Fragment>Đã sửa; bản đính chính đang chờ trong <a href="/blocks">khối chưa niêm phong</a></Fragment>
    )}</p>
  ) : null}
  {pending ? (
    <PendingState
      fill="sửa bài lúc này sẽ đổi hash, chưa sinh bản đính chính"
      segments={null}
    />
  ) : null}
</div>
