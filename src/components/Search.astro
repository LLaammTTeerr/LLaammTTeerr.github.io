---
// The box's styles travel with the box, like every other component here.
import '../styles/search.css';

/**
 * §9 — the nav row's fourth element: "identity, section links, search,
 * preferences". On every page, because it is layout chrome and a box a reader
 * loses the moment they open a post is not a search box.
 *
 * **Without JavaScript it ships disabled, with the reason stated**, rather than
 * being omitted. Three reasons, and the decision is deliberate:
 *
 *  - it is the site's own precedent. `/verify` and every post page render their
 *    control disabled and say in the same breath what it needs and what still
 *    works without it (`ChainVerifier.astro`, `TxVerifier.astro`);
 *  - omitting it teaches a reader nothing. A reader with scripts off would not
 *    learn that this site has search, nor why it is absent, nor where the same
 *    answers are — `/tx` lists every post and `/address` groups them by tag and
 *    series, and both work with nothing running;
 *  - the alternative to omitting it in the markup is injecting it from a
 *    script, which moves the nav row on every page load of the whole site.
 *
 * The explanation is in a `<noscript>` rather than in a paragraph the script
 * hides, which is the one place this differs from the verifier's pattern: the
 * verifier's status line has something to say on every run, whereas this one
 * would only ever flash through the nav row of every page and then vanish.
 *
 * The **combobox role is added by the script, not written here** (§ARIA). A
 * `role="combobox"` on a disabled input that can never expand is a promise to a
 * screen reader that nothing on the page can keep; what the static markup
 * claims is what it is, a disabled search field.
 *
 * `aria-describedby` names **two** ids and the script narrows it to one. With
 * scripting off, `#search-nojs` is the `<noscript>` paragraph and describes the
 * disabled field exactly. With scripting on that paragraph is not in the
 * document at all, so a lone `aria-describedby="search-nojs"` dangled — and it
 * kept dangling in the one case that matters, an island whose bundle failed to
 * load, where the field stays disabled with a description pointing at nothing.
 * `#search-hint` is in the markup unconditionally, so the list resolves in
 * every one of the three states.
 *
 * Deliberately not `define:vars`, for the reason `TxVerifier.astro` gives: it
 * would force the script inline, and an inline script cannot import — which
 * would mean reimplementing `searchFor` in the template.
 *
 * No clock (§14).
 */
---

<div class="search" role="search">
  <label class="sr-only" for="search-q">Search</label>
  <input
    id="search-q"
    class="search-input"
    type="search"
    name="q"
    placeholder="Search"
    autocomplete="off"
    spellcheck="false"
    aria-describedby="search-nojs search-hint"
    disabled
  />

  {/*
    Rendered only when nothing is going to enable the input above. `/tx` and
    `/address` are the two routes that answer the same questions with no script
    running at all.
  */}
  <noscript>
    <p class="search-nojs" id="search-nojs">
      Ô tìm kiếm <strong>cần JavaScript</strong>: nó tải <code>/search-index.json</code> rồi tìm ngay
      trong trình duyệt của bạn, không có máy chủ nào ở giữa. Không bật JavaScript thì{' '}
      <a href="/tx">danh sách giao dịch</a> vẫn liệt kê đủ mọi bài, và{' '}
      <a href="/address">danh sách địa chỉ</a> gom chúng theo tag và series.
    </p>
  </noscript>

  <div class="search-panel" id="search-panel" hidden>
    <ul class="search-list" id="search-list" role="listbox" aria-label="Search results"></ul>
    <p class="search-note" id="search-note" hidden></p>
    <p class="search-hint" id="search-hint">
      Tìm theo tiêu đề, tag, series — hoặc dán hash <code>0x…</code>, địa chỉ, hay{' '}
      <code>#height</code>.
    </p>
  </div>

  {/*
    The live region. Separate from the panel and always present, because a
    region announces a *change* to its own contents: one that appeared at the
    same moment as its text would announce nothing at all.
  */}
  <span class="sr-only" id="search-live" role="status" aria-live="polite"></span>
</div>

<script>
  import { attachSearch } from '../site/search-dom';
  import type { SearchIndex } from '../site/search-index';

  /**
   * §8 — the document, fetched once, when a reader first asks for it.
   *
   * The path is written out here at its call rather than held in a constant,
   * for the reason `TxVerifier.astro` gives: a constant is what a minifier
   * renames, and the §9 guard that reads the built bundle for off-origin
   * targets would be left with nothing to check.
   *
   * No `cache: 'no-store'`, unlike the verifier's fetches. A stale ledger is a
   * false answer to the question that control exists to ask; a stale search
   * index costs a reader at worst a post published since they last loaded the
   * site, and refusing the browser's cache would re-download it on every page.
   */
  async function load(): Promise<SearchIndex> {
    const response = await fetch('/search-index.json');
    if (!response.ok) throw new Error(`HTTP ${String(response.status)}`);
    return (await response.json()) as SearchIndex;
  }

  // Everything else is `src/site/search-dom.ts`, which is a module and not a
  // script body so that the suite can drive it. See the note at the top of it.
  attachSearch(document, { load, go: (href) => window.location.assign(href) });
</script>
