---
import { meterGeometry } from '../site/meter';
// This component is styled entirely by chain.css. Importing it here rather
// than from the page means a route that renders a WorkMeter cannot forget
// the stylesheet; Astro deduplicates it across components, so the extra
// imports cost nothing in the built CSS.
import '../styles/chain.css';

interface Props { nonce: number; difficulty: number }
const { nonce, difficulty } = Astro.props;

// Every 1× landmark below (tick, `exp` segment, guide line) comes from the
// geometry. Hard-coding any of them would restate the 3× span a second time
// and let the markup drift from the numbers it claims to show.
const {
  ratio, lucky, expected, span, barPct, tickPct,
  perSegment, segments, expectedSegmentIndex, path, guideX, markX, markY, fillPath,
} = meterGeometry(nonce, difficulty);
---

<div class="work">
  <div class="work-top">
    <span>Nonce <span class="num">{nonce.toLocaleString('en-US')}</span></span>
    <span class={`luck ${lucky ? 'good' : 'over'}`}>
      {ratio.toFixed(2)}× {lucky ? '— lucky' : 'expected'}
    </span>
  </div>

  <div class="meter meter-m1">
    <div class="bar-wrap">
      <div class="bar"><i class={lucky ? 'good' : ''} style={`width:${barPct}%`}></i></div>
      <span class="tick" style={`left:${tickPct.toFixed(2)}%`}></span>
    </div>
    <div class="scale"><span>0</span><span>1× · {expected.toLocaleString('en-US')}</span><span>{span}×</span></div>
  </div>

  <div class="meter meter-m2">
    <div class="segs">
      {segments.map((pct, i) => (
        <span class={`seg${i === expectedSegmentIndex ? ' exp' : ''}`}><span class={lucky ? 'good' : ''} style={`width:${pct}%`}></span></span>
      ))}
    </div>
    <div class="cap">1 segment = {Math.round(perSegment).toLocaleString('en-US')} attempts</div>
  </div>

  <div class="meter meter-m3">
    <svg viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true">
      <path d={`${path} L200,38 Z`} fill="currentColor" opacity="0.06" />
      <path d={fillPath} class={lucky ? 'fill-good' : 'fill-over'} />
      <path d={path} fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" vector-effect="non-scaling-stroke" />
      <line x1={guideX.toFixed(2)} y1="4" x2={guideX.toFixed(2)} y2="38" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" opacity="0.4" vector-effect="non-scaling-stroke" />
      <line x1={markX.toFixed(2)} y1={markY.toFixed(2)} x2={markX.toFixed(2)} y2="38" class={lucky ? 'mark-good' : 'mark-over'} stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="cap">chance of a hit by n attempts · landed at {ratio.toFixed(2)}×</div>
  </div>
</div>
