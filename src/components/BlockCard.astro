---
import WorkMeter from './WorkMeter.astro';
import { shortHash, splitHashWork } from '../site/chain-data';
import type { BlockView } from '../site/chain-data';
// The card's styles travel with the card — see the note in WorkMeter.astro.
import '../styles/chain.css';

interface Props { block: BlockView; isNewest: boolean; isOldest: boolean }
const { block, isNewest, isOldest } = Astro.props;

// Middle-truncated per the design spec (§9's "Type" rule), with the block's
// own proven leading zeros highlighted — the part of the hash that is
// actually the proof of work, not just whatever digits happened to follow.
// The merkle root gets the same truncation but no highlight: it was never
// mined against a difficulty target, so no prefix of it is "proven" zeros.
const hashWork = splitHashWork(block.shortHash, block.difficulty);
const merkleShort = shortHash(block.merkleRoot);
---

<div class="row" data-block={block.height}>
  <div class="gutter">
    <span class="spine" data-first={isNewest} data-last={isOldest}></span>
    <span class={`n${block.isEmpty ? ' q' : ''}`}>#{block.height}</span>
    <span class={`dot${block.isEmpty ? ' q' : ''}`}></span>
  </div>
  <article class={`card${block.isEmpty ? ' empty' : ''}`} aria-labelledby={`block-${block.height}-heading`}>
    <h2 id={`block-${block.height}-heading`} class="sr-only">Block #{block.height} · {block.period}</h2>
    <div class="card-top">
      <span class="per">{block.period}{block.isGenesis ? ' · genesis' : ''}</span>
      <span class="stamp">Sealed</span>
    </div>
    <dl class="meta">
      <dt>Hash</dt>
      <dd><span class="hash">{hashWork.marker}<mark class="zeros">{hashWork.zeros}</mark>{hashWork.rest}</span></dd>
      <dt>Merkle</dt>
      <dd><span class="hash">{merkleShort}</span></dd>
    </dl>
    <WorkMeter nonce={block.nonce} difficulty={block.difficulty} />
    {block.transactions.length > 0 ? (
      <ul class="txs">
        {block.transactions.map((tx) => (
          <li>
            <h3 class="t">{tx.slug ? <a href={`/tx/${tx.slug}`}>{tx.title}</a> : (tx.title ?? 'Amendment')}</h3>
            <span class="g">{tx.gasUsed} từ · {tx.value.toFixed(1)} giờ</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="silent">Không có bài viết nào trong tháng này. Khối vẫn được đào.</p>
    )}
  </article>
</div>
