---
import WorkMeter from './WorkMeter.astro';
import PendingState from './PendingState.astro';
import { researchHours, shortHash, splitHashWork } from '../site/chain-data';
import type { AnyBlockView } from '../site/chain-data';
// The card's styles travel with the card — see the note in WorkMeter.astro.
import '../styles/chain.css';

interface Props { block: AnyBlockView; isNewest: boolean; isOldest: boolean }
const { block, isNewest, isOldest } = Astro.props;

// Middle-truncated per the design spec (§9's "Type" rule), with the block's
// own proven leading zeros highlighted — the part of the hash that is
// actually the proof of work, not just whatever digits happened to follow.
// The merkle root gets the same truncation but no highlight: it was never
// mined against a difficulty target, so no prefix of it is "proven" zeros.
// Neither exists yet on the open block — nothing has been mined — so both
// stay `null` there rather than being computed against fields that don't exist.
const hashWork = block.sealed ? splitHashWork(block.shortHash, block.difficulty) : null;
const merkleShort = block.sealed ? shortHash(block.merkleRoot) : null;
const isEmpty = block.sealed && block.isEmpty;

// The gutter number is the block's identity, so it is what links to the
// block's own page — but only once the block is sealed. The open block's
// height is a prediction: a size split can seal a block ahead of it and move
// it. `/block/<height>` exists for sealed blocks alone, so linking the open
// one there would name a height the chain has not committed to, which is the
// same class of falsehood as printing a hash it has not mined. The open block
// is already on this page, which is where it stays reachable.
---

<div class="row" data-block={block.height}>
  <div class="gutter">
    <span class="spine" data-first={isNewest} data-last={isOldest}></span>
    <span class={`n${isEmpty ? ' q' : ''}`}>{block.sealed ? (
      <a href={`/block/${block.height}`}>#{block.height}</a>
    ) : (
      <Fragment>#{block.height}</Fragment>
    )}</span>
    <span class={`dot${block.sealed ? (isEmpty ? ' q' : '') : ' open'}`}></span>
  </div>
  <article class={`card${isEmpty ? ' empty' : ''}`} aria-labelledby={`block-${block.height}-heading`}>
    <h2 id={`block-${block.height}-heading`} class="sr-only">Block #{block.height} · {block.period}</h2>
    <div class="card-top">
      <span class="per">{block.period}{block.sealed && block.isGenesis ? ' · genesis' : ''}</span>
      <span class={`stamp${block.sealed ? '' : ' open'}`}>{block.sealed ? 'Sealed' : 'Chưa niêm phong'}</span>
    </div>
    <dl class="meta">
      <dt>Hash</dt>
      <dd>{hashWork ? (
        <span class="hash">{hashWork.marker}<mark class="zeros">{hashWork.zeros}</mark>{hashWork.rest}</span>
      ) : (
        <span class="hash">— chưa có, khối chưa đào</span>
      )}</dd>
      <dt>Merkle</dt>
      <dd>{merkleShort ? (
        <span class="hash">{merkleShort}</span>
      ) : (
        <span class="hash">— chưa có, khối chưa đào</span>
      )}</dd>
    </dl>
    {block.sealed ? <WorkMeter nonce={block.nonce} difficulty={block.difficulty} /> : null}
    {block.transactions.length > 0 ? (
      <ul class="txs">
        {block.transactions.map((tx) => {
          // §3.8: an undeclared `research` is an em dash, not `0.0 giờ`.
          const hours = researchHours(tx.value);
          return (
            <li>
              <h3 class="t">{tx.slug ? <a href={`/tx/${tx.slug}`}>{tx.title}</a> : (tx.title ?? 'Amendment')}</h3>
              <span class="g">{tx.gasUsed} từ · {hours ? `${hours} giờ` : '—'}</span>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="silent">Không có bài viết nào trong tháng này. Khối vẫn được đào.</p>
    )}
    {!block.sealed ? (
      <PendingState
        fill={`${block.txCount}/${block.maxTxPerBlock} giao dịch · chốt ${block.sealsOn}`}
        segments={{ on: block.txCount, of: block.maxTxPerBlock }}
      />
    ) : null}
  </article>
</div>
