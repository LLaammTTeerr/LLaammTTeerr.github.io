---
import type { AmendmentEntry } from '../site/tx-index';
import { shortHash, txMetaLine } from '../site/chain-data';
// `.txs` and its `.t` / `.g` children are BlockCard's list classes
// (src/styles/chain.css), the same ones `TxRow.astro` reuses — so a post row
// and an amendment row sitting in one list read as one list.
import '../styles/chain.css';

/**
 * One amendment as a row in the transaction index (`/tx`).
 *
 * The sibling of `TxRow.astro`, and deliberately not the same component. A post
 * row describes a **post**, resolved to the state the chain asserts now
 * (§3.9); this describes a **ledger entry** — the transaction that recorded the
 * edit. `/blocks` and `/block/<height>` already render an amendment this way
 * inside their block's card, and this is that row, extracted so a transaction
 * index can render a mixed list without either kind borrowing the other's
 * meaning.
 *
 * The prop is an `AmendmentEntry`, whose `tx` is `RecordedTx` narrowed to
 * `type: 'amendment'`. A post transaction is a type error here, which matters:
 * `txMetaLine` is only safe on an amendment. Handed a post it prints that
 * post's *sealed* word count and hours, which after an amendment is the state
 * the chain has superseded — the defect this project has fixed five times.
 *
 * **An amendment has no slug and no page of its own** (§3.9). It belongs to the
 * post it amends, so the title links there: `/tx/<slug>` renders the governing
 * record, which after this amendment is this amendment. The link goes to the
 * page that shows what this transaction says, not to a page about some other
 * state of it. When the amended post cannot be found on the chain the title is
 * plain text — the site links only to what exists.
 *
 * `pending` is not computed here. It travels on the entry from
 * `src/site/tx-index.ts`, which knows whether the block holding this amendment
 * is sealed; a component that guessed would be the caller-supplied `pending`
 * flag that once rendered `Sealed` over an unconfirmed transaction.
 */
interface Props {
  entry: AmendmentEntry;
}
const { entry } = Astro.props;
const { tx, amendedSlug, pending } = entry;

// §3.9 — `title` is the title the amendment declares, and it is hash-covered by
// the `amendment/1` canonical form. `detectAmendments` always sets it; the
// fallback is for a ledger written before it did, and says what the row is
// rather than printing an empty heading.
const title = tx.title ?? 'Amendment';
---

<li data-amends={tx.amends}>
  <h2 class="t">{amendedSlug !== null ? (
    <a href={`/tx/${amendedSlug}`}>{title}</a>
  ) : (
    <Fragment>{title}</Fragment>
  )}</h2>
  <span class="g">
    {/* §3.6 — the same `~` marker TxRow and TxPanel use for a hash the chain
        has not sealed. An amendment waiting in the open block has a true hash
        and no seal, exactly like a freshly published post. */}
    {pending ? (
      <span class="a-hash"><span class="tilde">~</span>{shortHash(tx.hash)}</span>
    ) : (
      <span class="hash">{shortHash(tx.hash)}</span>
    )}
    {' · '}{tx.date}{' · '}
    {/* §3.8/§3.9 — the one definition of this line, shared with the block card
        and the block page: an amendment states where its figures were counted
        instead of printing the accounting zeros §3.9 fixes it at. */}
    {txMetaLine(tx)}
    {tx.amends !== null ? (
      /* The transaction this one supersedes — `TxPanel`'s `Amends` field, in a
         list's truncated form. Where `TxRow` ends a post's row with `đã sửa`
         pointing at the amendment, an amendment's row ends by naming the
         original, so a reader can reconcile the two hashes without leaving the
         index. Unlinked, like the panel's: the original transaction has no page
         of its own either — the post's page shows the governing record. */
      <Fragment>{' · '}sửa <span class="hash">{shortHash(tx.amends)}</span></Fragment>
    ) : null}
  </span>
</li>
